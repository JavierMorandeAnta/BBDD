3. Crear un script SQL en el servidor Ubuntu que cargue los datos desde el fichero recibido en la base de datos de MariaDB
              (Lo llamaremos cargar.sql en home/javier/Documentos)

CREATE DATABASE IF NOT EXISTS EXAMEN;
USE EXAMEN;

LOAD DATA LOCAL INFILE '/home/javier/Documentos/Auto.csv'
INTO TABLE notas
FIELDS TERMINATED BY ','
ENCLOSED BY '"'
