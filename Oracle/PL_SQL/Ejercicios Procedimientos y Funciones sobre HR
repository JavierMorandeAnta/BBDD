:Programar un scrpt que nos devuelva la tabla de multiplicar de un numero que es el valor inical al que se asigna la variable "num":

DECLARE                             -- Esto es un ejemplo de bloque anonimo
    i NUMBER :=0;
    inicio NUMBER := 0;
    final NUMBER :=10;
    resultado NUMBER :=0;
    num NUMBER := 4;
BEGIN
    FOR i in inicio..final LOOP
          resultado:= num*i;
          DBMS_OUTPUT.PUT_LINE('El numero es = ' || num || ' multiplicado por ' || i || ' el resultado es ' ||  resultado);
    END LOOP;
END;

:Función que encuentra el ID de un departamento, siendo el parametro de entrada el nombre del departamento y el valor de retorno el id del departamento, si no existe devuelve nulo:

Create or replace NONEDITIONABLE FUNCTION ID_DEPARTAMENTO 
                                (v_DEPARTMENT_NAME varchar2)                       
RETURN INT 
AS 
v_cantidad INT;
V_ID INT;
BEGIN
        Select COUNT(*) into v_cantidad FROM DEPARTMENTS WHERE DEPARTMENT_NAME = v_department_name;

        if v_cantidad = 1 then
            Select department_id into V_ID from departments where department_name = v_department_name;
            RETURN V_ID;
        else
            return null;
        end if;
END ID_DEPARTAMENTO;

:Crea una función a la cual le pasas un id del departamento y te da el maximo comision de ese departamento:

Create or replace NONEDITIONABLE FUNCTION F1_COMISSIO(V_DEPARTMENT_ID INT)
RETURN employees.COMMISSION_PCT%type
AS 
    v_comission_pct employees.COMMISSION_PCT%type;  -- con el %type nos referimos al mismo tipo que tiene la columna en nuestra tabla
    V_SOLU employees.department_id%type;
BEGIN

    SELECT count(*) INTO V_SOLU FROM EMPLOYEES WHERE V_DEPARTMENT_ID = DEPARTMENT_ID;  -- Se utiliza el count puesto que de otra manera daria mas de un resultado y no serviria

    IF V_SOLU>=1 then -- El select anterior tiene que darte minimo un departamento

        Select MAX(commission_pct) into v_comission_pct FROM employees where V_DEPARTMENT_ID = DEPARTMENT_ID; -- Con el max dara el maximo de comision 
        RETURN v_comission_pct;

    ELSE -- Si no existe ningun departamento te dara 0
        RETURN 0;
    END IF;

END F1_COMISSIO; 

:Crear un procedimiento que busca el id del departamento de ventas y el porcentaje de comision mas alta (Usando las funciones anteriores) y encuentra los datos para mostrarlos del trabajador del departamento con la comision mas alta:


CREATE OR REPLACE PROCEDURE P1_COMISION_VENTAS
as
    v_nom_departamento DEPARTMENTS.DEPARTMENT_NAME%TYPE;
    v_ID_departamento DEPARTMENTS.DEPARTMENT_ID%TYPE;
    
    v_comision_departamento EMPLOYEES.COMMISSION_PCT%type;
    
    v_emp employees%rowtype;        -- esta variable es cualquier tipo de dato que contenga la tabla employees
    
begin

    /* Busca el id del departamento de ventas Sales */
    
    v_nom_departamento:='Sales';
    
    v_ID_departamento := ID_DEPARTAMENTO(v_nom_departamento); -- Almacenamos el resultado de la función en una variable

    DBMS_OUTPUT.PUT_LINE( 'El id del departamento Sales sera ' || v_ID_departamento );
    
    
    /* En el id del departamento anterior buscara la comision mas alta de los empleados */

    v_comision_departamento := F1_COMISSIO(v_ID_departamento); -- Llamamos a la funcion con el id resultado de la anterior para que nos de la maxima comissio

    DBMS_OUTPUT.PUT_LINE( 'La comisión mas alta del departamento sera ' || v_comision_departamento);
    
    
    /* Encontrar el trabajador que tiene la comision mas grande y mostrar sus datos */
    
    select * into v_emp             -- Realizamos un cursor
    from employees
    where department_id=v_ID_departamento and commission_pct=v_comision_departamento
    
    fetch first 1 row only;         -- Leemos ese cursor

    dbms_output.put_line('----------------trabajdor de '|| v_nom_departamento ||'----------------');
    dbms_output.put_line(' NOMBRE: ' || v_emp.FIRST_NAME || ' ' || v_emp.LAST_NAME);                -- Mediante la variable seguido del .columna hacemos referencia a ese dato que tiene el cursor
    dbms_output.put_line(' EMAIL: ' || v_emp.EMAIL );
    dbms_output.put_line(' HIRE DATE: ' || v_emp.HIRE_DATE);
    dbms_output.put_line(' Comisión: ' || v_emp.COMMISSION_PCT*100 ||' % ');

end P1_COMISION_VENTAS;
