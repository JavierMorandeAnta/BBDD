:La estructura basica podria ser:

[Declare <Declaraciones>]
BEGIN
  <Instrucciones>
[EXCEPTION <gestión de excepciones>]
END;

:Podemos crear un procedimiento:

CREATE [OR REPLACE] PROCEDURE nombre_del_procedimiento
[Parametros..]
IS
BLOQUE (sin declare")

:Podemos crear una función almacenada y un disparador:

CREATE [OR REPLACE] FUNCTION nombre_de_la_funcion
[Parametros...]
RETURN tipo_dato
IS
BLOQUE

CREATE [OR REPLACE] TRIGGER nombre_del_disparador
definicion del disparador
BLOQUE

:OPERADORES:

Asignación      :=
Aritmeticos     +,-,*,/,**(exponenciación)
Relacionales    =(igual),<> (Distinto), <, >, <=, >=
Logicos         NOT(negación), OR (o), AND (y)
Concatenacion   || (Unión de cadenas de caracteres)

:Condicionales:

IF condicion1 THEN instrucciones1
  [  ELSIF condicion2 THEN instrucciones2 ..]
  [  ELSE instrucciones n]
END IF;

-- Una calculadora con condicionales

CREATE OR REPLACE PROCEDURE Calculadora (operando1  NUMBER
                                        ,operando2  NUMBER
                                        ,operador   CHAR)
IS
BEGIN
IF operador ='+' THEN DBMS_OUTPUT.PUT_LINE('La suma de '
                                          || TO_CHAR(operando1)||' + '||TO_CHAR(operando2)
                                          ||' es: '|| TO_CHAR(operando1+operando2));
ELSIF operador ='-' THEN DBMS_OUTPUT.PUT_LINE('La resta de '
                                          || TO_CHAR(operando1) ||'-'||TO_CHAR(operando2)
                                          ||' es: '|| TO_CHAR(operando1-operando2));
END IF;
END;
/

:Iterativas:

-- FOR

FOR contador IN [REVERSE] inicial..final LOOP
  Instrucciones
END LOOP;

-- WHILE

WHILE (condicion) LOOP
  Instrucciones
END LOOP;

-- LOOP

LOOP
  [Instrucciones1]
  IF (condicion) THEN EXIT;
  END IF;
  [Instrucciones2]
END LOOP;

:Cursores:

:Implicitos aquellos que solo devuelven un solo registro de la consulta en cuestión:

Declare
  nombre VARCHAR2(40);
BEGIN
  SELECT clt_nom INTO nombre FROM clientes WHERE clt_num=1;
  dbms_output.put.line('El clientes 1 se llama ' || nombre);
END;

:Explicitos aquellos que devuelven mas de un solo registro:

:Podemos declarar el cursor que utiliza directamente para poder llamarlo:

CURSOR nombre_cursor IS SELECT...

OPEN nombre_cursor;                                      -- Abrir el cursor en la sección de instrucciones

FETCH nombre_cursor INTO lista_variables o registro;     -- Leer los datos

CLOSE nombre_cursor                                      -- Cerrar el cursor y liberar sus recursos

:Gestión de excepciones:

:Hay algunas ya definidas:

NO_DATA_FOUND                                           -- El SELECT no encontro ninguna fila
TOO_MANY_ROWS                                           -- El SELECT dio mas de una fila
OTHERS                                                  -- Otras circustancias

:Podemos definir nosotros una excepcion:

EXCEPTION
        WHEN 'Nombre de la variable'
        THEN dbms_output.put_line('Mensaje de error');
END;

:EJEMPLO PLS/SQL:

SET SERVEROUTPUT ON;                                    -- Habilita la salida de datos
DECLARE
  num_articulo NUMBER(6);
  cod NUMBER(6);
  nombre CHAR(25);
BEGIN
  num_articulo:=1;
  SELECT art_num, art_nom INTO cod, nombre
  FROM artículos
  WHERE art_num=num_articulo;
DBMS_OUTPUT.PUT_LINE (cod||''||nombre);
END;
/

:Ejemplo procedimiento:

CREATE OR REPLACE PROCEDURE parametros
    (p1 IN INTEGER
    ,p2 OUT INTEGER
    ,p3 IN OUT INTEGER)
AS
BEGIN
    DMS_OUTPUT.PUT_LINE('Parametros recibidos');
    DMS_OUTPUT.PUT_LINE('P1 = '||p1);
    DMS_OUTPUT.PUT_LINE('P2 = '||p2);
    DMS_OUTPUT.PUT_LINE('P3 = '||p3);
     p2 := p1;
     p3 := p3*2;
END;
/

:Ejemplo Bloque Anonimo:

DECLARE
    p1 INTEGER := 1;
    p2 INTEGER := 2;
    p3 INTEGER := 3;
BEGIN
    DBMS_OUTPUT.PUT_LINE('Parametros inicializados');
    DBMS_OUTPUT.PUT_LINE('P1 = '||p1);
    DBMS_OUTPUT.PUT_LINE('P2 = '||p2);
    DBMS_OUTPUT.PUT_LINE('P3 = '||p3);
    parametros(p1, p2, p3);
    DBMS_OUTPUT.PUT_LINE('Parametros procesados');
    DBMS_OUTPUT.PUT_LINE('P1 = '||p1);
    DBMS_OUTPUT.PUT_LINE('P2 = '||p2);
    DBMS_OUTPUT.PUT_LINE('P3 = '||p3);
END;
/
