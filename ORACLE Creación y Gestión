:Creacion de TRIGGER:

CREATE OR REPLACE TRIGGER trigger_auto                                                                  --Creamos y asignamos un nombre--
BEFORE INSERT ON "ELNOMBREDELATABLA"                                                                    --Decimos en que lugar tomara forma este trigger--
FOR EACH ROW
BEGIN
  IF :NEW.id IS NULL THEN                                                                               --Introducimos el codigo PL/SQL--
    SELECT SEQUENCE NOTAS_seq.NEXTVAL INTO :NEW.id FROM dual;                                           --Hacemos alusion a la secuencia anteriormente creada para que la realice en DUAL--
  END IF;
END;
/                                                                                                       --El codigo PL/SQL finaliza con / --

