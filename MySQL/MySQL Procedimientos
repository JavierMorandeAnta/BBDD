:Procedimiento almacenado de prueba:

drop procedure if exists pa_libros_limite_stock;

 delimiter //
 create procedure pa_libros_limite_stock()
 begin
   select * from libros
   where stock<=10;
 end //
 delimiter ;

 call pa_libros_limite_stock();

