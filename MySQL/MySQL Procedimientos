:Ejemplo:

drop procedure if exists pa_tipo_medalla;

delimiter //
create procedure pa_tipo_medalla(
  in puesto int,
  out tipo varchar(20))
begin
  case puesto
    when 1 then
      set tipo='oro';
    when 2 then
      set tipo='plata';
    when 3 then
      set tipo='bronce';
    else
      set tipo='Sin trofeo';                        -- Asi comprobariamos si el numero no es 1,2,3 si introducimos otro puesto dara este mensaje
  end case;          
end //
delimiter ;

call pa_tipo_medalla(1,@ti);

select @ti;

