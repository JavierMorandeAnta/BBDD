:Trabajaremos sobre la base de datos "Planificador" y la tabla siguiente:

CREATE TABLE test(
 evento VARCHAR(50),
 fecha DATETIME 
); 

:Habilitaremos los eventos en la sesion que tenemos:

SET GLOBAL event_scheduler = ON;

:Incluiremos un evento:

CREATE EVENT insertion_event                                      --Indicas el nombre del evento--
ON SCHEDULE AT CURRENT_TIMESTAMP + INTERVAL 1 MINUTE              --El intervalo y el tiempo que tarda--
DO INSERT INTO test VALUES ('Evento 1', NOW());                   --Lo que hace el evento--

ON SCHEDULE AT '2018-12-31 12:00:00'                              --Podemos incluir en esa columna año,mes y dia ademas de hora donde se ejecutara--

:Si se ejecutará más de una sentencia SQL debemos de apoyarnos de BEGIN y END:

DELIMITER //

CREATE EVENT insertion_event
ON SCHEDULE AT CURRENT_TIMESTAMP + INTERVAL 1 MINUTE
DO
BEGIN
 INSERT INTO test VALUES ('Evento 1', NOW());
 INSERT INTO test VALUES ('Evento 2', NOW());
 INSERT INTO test VALUES ('Evento 3', NOW());
END //

DELIMITER ;

:Podemos ver los eventos que tenemos:

SHOW EVENTS;

:Podemos borrar el evento.

DROP EVENT nombre_evento;

:Una vez finalice el evento se borrara a no ser que se incluya este termino:

ON COMPLETION PRESERVE

:Podemos guardar el procedimiento que realiza y llamarlo a un momento determinado con esto:

CREATE EVENT nombre_evento
ON SCHEDULE AT 'fecha de ejeución' 
DO
CALL store_procedure();

:Eventos periódicos:

CREATE EVENT insertion_event
ON SCHEDULE EVERY 1 MINUTE STARTS '2018-07-07 18:30:00'         --Cada cuanto y cuando empieza--
ENDS '2018-07-07 19:00:00'                                      --Podemos marcar cuando finaliza el evento--
DO INSERT INTO test VALUES ('Evento 1', NOW());                 --Lo que realiza--

:Editar Eventos:

ALTER EVENT insertion_event                                     --Para apagar el evento--
DISABLE;

ALTER EVENT nombre_evento                                       --Para restaurar el evento--
ENABLE;

SET GLOBAL event_scheduler = OFF;                               --Detener todos los eventos--

:O editarlo de forma completa:

ALTER EVENT insertion_event 
ON SCHEDULE EVERY 1 MINUTE STARTS 'FECHA DESEADA'               --De igual manera a la creación solo incluyendo ALTER EVENT--                               
DO INSERT INTO test VALUES ('Evento 1', NOW());                 

:Evento complejo modificable:

CREATE
    [DEFINER = { user | CURRENT_USER }]
    EVENT
    [IF NOT EXISTS]
    event_name
    ON SCHEDULE :schedule: + :interval:
    [ON COMPLETION [NOT] PRESERVE]
    [ENABLE | DISABLE | DISABLE ON SLAVE]
    [COMMENT 'string']
    DO event_body;

:schedule:
    AT timestamp [+ INTERVAL interval] ...
  | EVERY interval
    [STARTS timestamp [+ INTERVAL interval] ...]
    [ENDS timestamp [+ INTERVAL interval] ...]

:interval:
    quantity {YEAR | QUARTER | MONTH | DAY | HOUR | MINUTE |
              WEEK | SECOND | YEAR_MONTH | DAY_HOUR | DAY_MINUTE |
              DAY_SECOND | HOUR_MINUTE | HOUR_SECOND | MINUTE_SECOND}
