Use Jardineria;

:Optimizar esta consulta:

EXPLAIN SELECT nombre_contacto, telefono
FROM cliente
WHERE pais = 'France';

--Vemos que en ella el select_type no incluye un indice haciendo que tenga que realizar una busqueda en todas las rows--

--Podemos realizar un indice sobre una columna para optimizar la consulta--

SHOW INDEX FROM cliente;

CREATE INDEX idx_pais ON cliente(pais);

:Optimizar esta consulta:

EXPLAIN SELECT *
FROM producto
WHERE nombre LIKE '%acero%' OR descripcion LIKE '%acero%';

--Podemos crear un indice por el texto--

CREATE FULLTEXT INDEX idx_nombre_descripcion ON producto(nombre, descripcion);

--Y realizar la consulta optimizada--

EXPLAIN SELECT *
FROM producto
WHERE MATCH(nombre, descripcion) AGAINST ('acero');

:Optimizar esta consulta:

SELECT AVG(total)
FROM pago
WHERE fecha_pago >= '2008-01-01' AND fecha_pago <= '2008-12-31';

--Podemos optimizarla Utilizando YEAR--

SELECT AVG(total)
FROM pago
WHERE YEAR(fecha_pago) = 2008;

--O con un Indice--

create index FECHA_PAGO on pago(FECHA_PAGO);

:Optimizar esta consulta:

explain
SELECT *
FROM cliente INNER JOIN pedido
ON cliente.codigo_cliente = pedido.codigo_cliente
WHERE cliente.nombre_cliente LIKE 'A%';
