Use Jardineria;

:Optimizar esta consulta:

EXPLAIN SELECT nombre_contacto, telefono
FROM cliente
WHERE pais = 'France';

--Vemos que en ella el select_type no incluye un indice haciendo que tenga que realizar una busqueda en todas las rows--

--Podemos realizar un indice sobre una columna para optimizar la consulta--

SHOW INDEX FROM cliente;

CREATE INDEX idx_pais ON cliente(pais);

:Optimizar esta consulta:

EXPLAIN SELECT *
FROM producto
WHERE nombre LIKE '%acero%' OR descripcion LIKE '%acero%';

--Podemos crear un indice por el texto--

CREATE FULLTEXT INDEX idx_nombre_descripcion ON producto(nombre, descripcion);

--Y realizar la consulta optimizada--

EXPLAIN SELECT *
FROM producto
WHERE MATCH(nombre, descripcion) AGAINST ('acero');

:Optimizar esta consulta:

SELECT AVG(total)
FROM pago
WHERE fecha_pago >= '2008-01-01' AND fecha_pago <= '2008-12-31';

--Podemos optimizarla Utilizando YEAR--

SELECT AVG(total)
FROM pago
WHERE YEAR(fecha_pago) = 2008;

--O con un Indice--

create index FECHA_PAGO on pago(FECHA_PAGO);

:Optimizar esta consulta:

explain
SELECT *
FROM cliente INNER JOIN pedido
ON cliente.codigo_cliente = pedido.codigo_cliente
WHERE cliente.nombre_cliente LIKE 'A%';

--Creacion de indice donde recorre los mayores row--

create index idx_codigo_cliente on cliente(nombre_cliente)

:Configuración y optimizacion para consultas lentas:

show variables like 'slow_query_log%';                                    --Para poder visualizar el estado de las consultas lentas ON/OFF--

SHOW VARIABLES LIKE 'pid_file';                                           --Podemos ver donde esta el archivo de configuración--

:En el archivo de configuración my.ini incluimos esta cuestión para poder activarlos:

slow_query_log = 1

slow_query_log_file = /var/log/mysql/mysql-slow.log                       --Podemos especificar la ruta donde se guardan las cuestiones--

long_query_time = 2                                                       --El tiempo que consideramos una consulta lenta--

log-queries-not-using-indexes                                             --Guarda aquellas consultas que no están haciendo uso de índices--

:Podemos ver estas variables usando workbench:

SHOW GLOBAL VARIABLES LIKE 'slow_query_log';
SHOW GLOBAL VARIABLES LIKE 'slow_query_log_file';
SHOW GLOBAL VARIABLES LIKE 'long_query_time';
SHOW GLOBAL VARIABLES LIKE 'log_queries_not_using_indexes';

--Y activarlas--

SET GLOBAL slow_query_log = 1;
SET GLOBAL long_query_time = 2;
SET GLOBAL slow_query_log_file = 'C:/mysql/data/slow';
SET GLOBAL log_queries_not_using_indexes = 1;



