CREATE TABLESPACE Prueba
DATAFILE 'C:/APP/JAVIER/PRODUCT/21C/ORADATA/XE/XEPDB1/Prueba.dbf'   --Ruta del archivo donde se guarda--
SIZE 100M                                                           --El tamaño que tendra el fichero y la TABLESPACE--
AUTOEXTEND ON NEXT                                                  --Si queremos que se extienda automaticamente--
50M MAXSIZE UNLIMITED;                                              --El limite que hasta donde se extiende--

:Asignar esa Tablespace a un usuario creado:

--Si el usuario no esta creado--

CREATE USER nombre_usuario
IDENTIFIED BY contraseña
DEFAULT TABLESPACE prueba
QUOTA UNLIMITED ON prueba;

--Si el usuario ya esta creado podemos alterarlo con un administrador--

ALTER USER nombre_usuario
DEFAULT TABLESPACE prueba -- Nombre de la Tablespace--
QUOTA UNLIMITED ON prueba;

--Revisar que Tablaespace utiliza el usuario---

SELECT username, default_tablespace
FROM dba_users
WHERE username = 'JAVIER';

:Poner en Offline/Online o solo lectura la Tablespace:

ALTER TABLESPACE prueba OFFLINE; --Podemos hacer lo mismo con Online--

ALTER TABLESPACE prueba READ ONLY; --Solo lectura--

:Apagar y encender por pasos la database:

SHUTDOWN normal/inmmediate/abort; --Paramos o apagamos la database--

STARTUP nomount; --Iniciamos sin montar la database--

ALTER database mount; --Montarla--

ALTER database open; --Abrimos la database--
